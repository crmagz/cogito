{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.dev/schemas/domain.schema.json",
  "title": "Cogito domain metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domain", "owner", "services", "credentials", "network", "evaluation", "operations"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "domain": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "owner": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "package", "version", "registration"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "package": {"type": "string", "pattern": "^packages/[a-z][a-z0-9-]{0,62}/[a-z][a-z0-9-]{0,62}$"},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "registration": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}$"},
              "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
            }
          }
        }
      }
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "secretKeys"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "secretKeys": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ingress", "egress"],
      "properties": {
        "ingress": {"type": "string", "minLength": 1},
        "egress": {"type": "string", "minLength": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixturePolicy"],
      "properties": {"fixturePolicy": {"type": "string", "minLength": 1}}
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runbook"],
      "properties": {"runbook": {"type": "string", "pattern": "^docs/[^#]+#.+"}}
    }
  }
}
