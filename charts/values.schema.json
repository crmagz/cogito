{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "observability": {
      "type": "object",
      "properties": {
        "traces": { "$ref": "#/definitions/toggle" },
        "metrics": { "$ref": "#/definitions/toggle" },
        "spanEvents": { "$ref": "#/definitions/toggle" },
        "otlp": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string" },
            "protocol": { "enum": ["http/protobuf", "grpc"] },
            "insecure": { "type": "boolean" },
            "existingSecret": { "type": "string" },
            "headersKey": { "type": "string", "minLength": 1 }
          }
        },
        "metricExportIntervalMillis": { "type": "integer", "minimum": 1000 },
        "resourceAttributes": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 256 } }
      }
    },
    "litellm": {
      "type": "object",
      "properties": {
        "rolePolicies": {
          "type": "object",
          "required": ["planner", "developer", "reviewerPrimary", "reviewerSecondary"],
          "properties": {
            "planner": { "$ref": "#/definitions/rolePolicy" },
            "developer": { "$ref": "#/definitions/rolePolicy" },
            "reviewerPrimary": { "$ref": "#/definitions/rolePolicy" },
            "reviewerSecondary": { "$ref": "#/definitions/rolePolicy" }
          }
        }
      }
    },
    "mcp": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "image": { "type": "object" },
        "service": {
          "type": "object",
          "properties": {
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "github": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "image": { "type": "object" },
            "service": {
              "type": "object",
              "properties": {
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            },
            "app": {
              "type": "object",
              "properties": {
                "existingSecret": { "type": "string" },
                "appIdKey": { "type": "string", "minLength": 1 },
                "installationIdKey": { "type": "string", "minLength": 1 },
                "privateKeyKey": { "type": "string", "minLength": 1 },
                "apiUrl": { "type": "string", "format": "uri" },
                "apiVersion": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
                "allowedRepositories": {
                  "type": "array",
                  "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,100}/[A-Za-z0-9_.-]{1,100}$" },
                  "maxItems": 1,
                  "uniqueItems": true
                },
                "timeoutSeconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 }
              }
            },
            "egressProxy": {
              "type": "object",
              "properties": {
                "url": { "type": "string" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "networkPolicyPeers": { "type": "array" }
              }
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "execution": {
          "type": "object",
          "properties": {
            "networkPolicy": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "dnsServiceCidrs": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "gitEgress": { "$ref": "#/definitions/networkPolicyPeers" },
                "objectStoreEgress": { "$ref": "#/definitions/networkPolicyPeers" },
                "additionalEgress": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["name", "networkPolicyPeers", "ports"],
                    "properties": {
                      "name": { "type": "string", "minLength": 1, "maxLength": 63 },
                      "networkPolicyPeers": { "$ref": "#/definitions/networkPolicyPeers" },
                      "ports": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["port"],
                          "properties": {
                            "protocol": { "enum": ["TCP", "UDP", "SCTP"] },
                            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "toggle": {
      "type": "object",
      "properties": { "enabled": { "type": "boolean" } },
      "required": ["enabled"]
    },
    "rolePolicy": {
      "type": "object",
      "required": ["model", "maxBudgetUsd", "budgetDuration", "toolset", "existingSecret", "apiKeyKey"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "maxBudgetUsd": { "type": "number", "exclusiveMinimum": 0 },
        "budgetDuration": { "type": "string", "minLength": 1 },
        "toolset": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "apiKeyKey": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicyPeers": {
      "type": "array",
      "items": { "type": "object", "minProperties": 1 }
    }
  }
}
