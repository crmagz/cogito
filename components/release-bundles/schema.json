{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogito.dev/schemas/release-bundle.schema.json",
  "title": "Cogito environment release bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "services"],
  "properties": {
    "schemaVersion": {"const": "1"},
    "environment": {"type": "string", "minLength": 1},
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["package", "packageVersion", "registration", "manifestSha256", "image"],
        "properties": {
          "package": {"type": "string", "pattern": "^packages/[a-z][a-z0-9-]{0,62}/[a-z][a-z0-9-]{0,62}$"},
          "packageVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "registration": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,127}@[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "image": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "digest"],
            "properties": {
              "repository": {"type": "string", "minLength": 1},
              "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
            }
          }
        }
      }
    }
  }
}
